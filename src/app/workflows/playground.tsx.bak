import { useEffect, useState } from 'react';

// URL de base de n8n
const N8N_URL = process.env.NEXT_PUBLIC_N8N_URL || 'https://192.168.10.50:5678';

// Types pour les données des workflows
interface WorkflowNode {
  id: string;
  name: string;
  type: string;
  position: [number, number];
  parameters: Record<string, any>;
}

interface WorkflowConnection {
  main: Array<Array<{ node: string; type: string; index: number }>>;
}

interface Workflow {
  id: string;
  name: string;
  active: boolean;
  createdAt: string;
  updatedAt: string;
  nodes: WorkflowNode[];
  connections: Record<string, WorkflowConnection>;
  description?: string;
}

interface WorkflowExecution {
  id: string;
  finished: boolean;
  mode: string;
  startedAt: string;
  stoppedAt?: string;
  status: string;
  data?: Record<string, any>;
  workflowId: string;
}

interface PlaygroundProps {
  authToken: string | null;
  onDebugLog: (message: string) => void;
}

export default function Playground({ authToken, onDebugLog }: PlaygroundProps) {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [workflows, setWorkflows] = useState<Workflow[]>([]);
  const [selectedWorkflow, setSelectedWorkflow] = useState<Workflow | null>(null);
  const [workflowDetails, setWorkflowDetails] = useState<Workflow | null>(null);
  
  // États pour les exécutions de workflow
  const [executionLoading, setExecutionLoading] = useState(false);
  const [executionError, setExecutionError] = useState<string | null>(null);
  const [executions, setExecutions] = useState<WorkflowExecution[]>([]);
  const [selectedExecution, setSelectedExecution] = useState<WorkflowExecution | null>(null);
  const [executionData, setExecutionData] = useState<any | null>(null);
  const [activeTab, setActiveTab] = useState<'details' | 'executions' | 'api'>('details');

  // Fonction pour récupérer la liste des workflows depuis n8n
  const fetchWorkflows = async () => {
    if (!authToken) {
      onDebugLog(`${new Date().toISOString()} - Impossible de récupérer les workflows: pas de token d'authentification`);
      return;
    }
    
    setLoading(true);
    try {
      onDebugLog(`${new Date().toISOString()} - Récupération de la liste des workflows`);
      
      // Utiliser notre proxy pour éviter les problèmes CORS et de certificat
      const response = await fetch(`/api/n8n/proxy?path=/api/v1/workflows`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-N8N-API-KEY': authToken
        },
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error(`Erreur lors de la récupération des workflows: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      setWorkflows(data.data || []);
      onDebugLog(`${new Date().toISOString()} - ${data.data?.length || 0} workflows récupérés`);
    } catch (error) {
      setError(`Erreur lors de la récupération des workflows: ${(error as Error).message}`);
      onDebugLog(`${new Date().toISOString()} - Erreur: ${(error as Error).message}`);
    } finally {
      setLoading(false);
    }
  };
  
  // Fonction pour récupérer les détails d'un workflow spécifique
  const fetchWorkflowDetails = async (workflowId: string) => {
    if (!authToken) {
      onDebugLog(`${new Date().toISOString()} - Impossible de récupérer les détails: pas de token d'authentification`);
      return;
    }
    
    try {
      onDebugLog(`${new Date().toISOString()} - Récupération des détails du workflow ${workflowId}`);
      
      const response = await fetch(`/api/n8n/proxy?path=/api/v1/workflows/${workflowId}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-N8N-API-KEY': authToken
        },
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error(`Erreur lors de la récupération des détails: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      setWorkflowDetails(data);
      onDebugLog(`${new Date().toISOString()} - Détails du workflow récupérés`);
    } catch (error) {
      setError(`Erreur lors de la récupération des détails: ${(error as Error).message}`);
      onDebugLog(`${new Date().toISOString()} - Erreur: ${(error as Error).message}`);
    }
  };

  // Effet pour récupérer les workflows au chargement du composant
  useEffect(() => {
    if (authToken && workflows.length === 0) {
      fetchWorkflows();
    }
  }, [authToken]);

  // Fonction pour exécuter un workflow
  const executeWorkflow = async (workflowId: string) => {
    if (!authToken) {
      onDebugLog(`${new Date().toISOString()} - Impossible d'exécuter le workflow: pas de token d'authentification`);
      return;
    }
    
    setExecutionLoading(true);
    setExecutionError(null);
    
    try {
      onDebugLog(`${new Date().toISOString()} - Exécution du workflow ${workflowId}`);
      
      const response = await fetch(`/api/n8n/proxy?path=/api/v1/workflows/${workflowId}/run`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-N8N-API-KEY': authToken
        },
        credentials: 'include',
        body: JSON.stringify({
          workflowData: workflowDetails
        })
      });
      
      if (!response.ok) {
        throw new Error(`Erreur lors de l'exécution du workflow: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      onDebugLog(`${new Date().toISOString()} - Workflow exécuté avec succès, ID d'exécution: ${data.executionId}`);
      
      // Récupérer les exécutions après un exécution réussie
      fetchWorkflowExecutions(workflowId);
      
      return data;
    } catch (error) {
      setExecutionError(`Erreur lors de l'exécution du workflow: ${(error as Error).message}`);
      onDebugLog(`${new Date().toISOString()} - Erreur: ${(error as Error).message}`);
    } finally {
      setExecutionLoading(false);
    }
  };
  
  // Fonction pour récupérer les exécutions d'un workflow
  const fetchWorkflowExecutions = async (workflowId: string) => {
    if (!authToken) {
      onDebugLog(`${new Date().toISOString()} - Impossible de récupérer les exécutions: pas de token d'authentification`);
      return;
    }
    
    setExecutionLoading(true);
    try {
      onDebugLog(`${new Date().toISOString()} - Récupération des exécutions du workflow ${workflowId}`);
      
      const response = await fetch(`/api/n8n/proxy?path=/api/v1/executions?workflowId=${workflowId}&limit=10`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-N8N-API-KEY': authToken
        },
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error(`Erreur lors de la récupération des exécutions: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      setExecutions(data.data || []);
      onDebugLog(`${new Date().toISOString()} - ${data.data?.length || 0} exécutions récupérées`);
    } catch (error) {
      setExecutionError(`Erreur lors de la récupération des exécutions: ${(error as Error).message}`);
      onDebugLog(`${new Date().toISOString()} - Erreur: ${(error as Error).message}`);
    } finally {
      setExecutionLoading(false);
    }
  };
  
  // Fonction pour récupérer les détails d'une exécution
  const fetchExecutionDetails = async (executionId: string) => {
    if (!authToken) {
      onDebugLog(`${new Date().toISOString()} - Impossible de récupérer les détails d'exécution: pas de token d'authentification`);
      return;
    }
    
    try {
      onDebugLog(`${new Date().toISOString()} - Récupération des détails de l'exécution ${executionId}`);
      
      const response = await fetch(`/api/n8n/proxy?path=/api/v1/executions/${executionId}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-N8N-API-KEY': authToken
        },
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error(`Erreur lors de la récupération des détails d'exécution: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      setExecutionData(data);
      onDebugLog(`${new Date().toISOString()} - Détails de l'exécution récupérés`);
    } catch (error) {
      setExecutionError(`Erreur lors de la récupération des détails d'exécution: ${(error as Error).message}`);
      onDebugLog(`${new Date().toISOString()} - Erreur: ${(error as Error).message}`);
    }
  };

  // Effet pour récupérer les détails d'un workflow lorsqu'il est sélectionné
  useEffect(() => {
    if (selectedWorkflow) {
      fetchWorkflowDetails(selectedWorkflow.id);
      // Récupérer aussi les exécutions du workflow sélectionné
      fetchWorkflowExecutions(selectedWorkflow.id);
    } else {
      setWorkflowDetails(null);
      setExecutions([]);
    }
  }, [selectedWorkflow]);
  
  // Effet pour récupérer les détails d'une exécution lorsqu'elle est sélectionnée
  useEffect(() => {
    if (selectedExecution) {
      fetchExecutionDetails(selectedExecution.id);
    } else {
      setExecutionData(null);
    }
  }, [selectedExecution]);

  return (
    <div className="bg-white rounded-lg shadow">
      <div className="p-6">
        <h3 className="text-xl font-semibold mb-4">Playground n8n</h3>
        
        {/* Affichage des erreurs */}
        {error && (
          <div className="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
            <div className="flex">
              <div className="flex-shrink-0">
                <svg className="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clipRule="evenodd" />
                </svg>
              </div>
              <div className="ml-3">
                <p className="text-sm text-red-700">{error}</p>
              </div>
            </div>
          </div>
        )}
        
        {/* Affichage des erreurs d'exécution */}
        {executionError && (
          <div className="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
            <div className="flex">
              <div className="flex-shrink-0">
                <svg className="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clipRule="evenodd" />
                </svg>
              </div>
              <div className="ml-3">
                <p className="text-sm text-red-700">{executionError}</p>
              </div>
            </div>
          </div>
        )}
        
        {/* Vue principale du playground */}
        <div className="flex">
          {/* Liste des workflows */}
          <div className="w-1/3 pr-4 border-r">
            <h4 className="text-lg font-medium mb-3">Workflows</h4>
            
            {loading ? (
              <div className="flex justify-center items-center py-8">
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
              </div>
            ) : workflows.length > 0 ? (
              <div className="space-y-2 max-h-[600px] overflow-y-auto pr-2">
                {workflows.map((workflow) => (
                  <div 
                    key={workflow.id}
                    className={`p-3 rounded-md cursor-pointer transition-colors ${selectedWorkflow?.id === workflow.id ? 'bg-blue-100 border-blue-300 border' : 'bg-gray-50 hover:bg-gray-100 border border-gray-200'}`}
                    onClick={() => setSelectedWorkflow(workflow)}
                  >
                    <div className="font-medium">{workflow.name}</div>
                    <div className="text-xs text-gray-500 mt-1">
                      {workflow.active ? (
                        <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                          Actif
                        </span>
                      ) : (
                        <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                          Inactif
                        </span>
                      )}
                      <span className="ml-2">ID: {workflow.id.substring(0, 8)}...</span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-center py-8 text-gray-500">
                <p>Aucun workflow trouvé</p>
                <button
                  className="mt-2 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                  onClick={fetchWorkflows}
                >
                  Rafraîchir
                </button>
              </div>
            )}
          </div>
          
          {/* Détails du workflow */}
          <div className="w-2/3 pl-4">
            <h4 className="text-lg font-medium mb-3">Détails du workflow</h4>
            
            {selectedWorkflow ? (
              workflowDetails ? (
                <div className="bg-gray-50 rounded-lg p-4 max-h-[600px] overflow-y-auto">
                  <div className="mb-4">
                    <h5 className="text-xl font-bold">{workflowDetails.name}</h5>
                    <p className="text-sm text-gray-600 mt-1">{workflowDetails.description || 'Aucune description'}</p>
                  </div>
                  
                  <div className="grid grid-cols-2 gap-4 mb-4">
                    <div className="bg-white p-3 rounded border border-gray-200">
                      <span className="text-xs text-gray-500 block">Statut</span>
                      <span className={`font-medium ${workflowDetails.active ? 'text-green-600' : 'text-gray-600'}`}>
                        {workflowDetails.active ? 'Actif' : 'Inactif'}
                      </span>
                    </div>
                    <div className="bg-white p-3 rounded border border-gray-200">
                      <span className="text-xs text-gray-500 block">ID</span>
                      <span className="font-medium text-gray-800">{workflowDetails.id}</span>
                    </div>
                      </span>
                    )}
                    <span className="ml-2">ID: {workflow.id.substring(0, 8)}...</span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className="text-center py-8 text-gray-500">
              <p>Aucun workflow trouvé</p>
              <button
                className="mt-2 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                onClick={fetchWorkflows}
              >
                Rafraîchir
              </button>
            </div>
          )}
        </div>
        
        {/* Détails du workflow */}
        <div className="w-2/3 pl-4">
          <h4 className="text-lg font-medium mb-3">Détails du workflow</h4>
          
          {selectedWorkflow ? (
            workflowDetails ? (
              <div className="bg-gray-50 rounded-lg p-4 max-h-[600px] overflow-y-auto">
                <div className="mb-4">
                  <h5 className="text-xl font-bold">{workflowDetails.name}</h5>
                  <p className="text-sm text-gray-600 mt-1">{workflowDetails.description || 'Aucune description'}</p>
                </div>
                
                <div className="grid grid-cols-2 gap-4 mb-4">
                  <div className="bg-white p-3 rounded border border-gray-200">
                    <span className="text-xs text-gray-500 block">Statut</span>
                    <span className={`font-medium ${workflowDetails.active ? 'text-green-600' : 'text-gray-600'}`}>
                      {workflowDetails.active ? 'Actif' : 'Inactif'}
                    </span>
                  </div>
                  <div className="bg-white p-3 rounded border border-gray-200">
                    <span className="text-xs text-gray-500 block">ID</span>
                    <span className="font-medium text-gray-800">{workflowDetails.id}</span>
                  </div>
                  <div className="bg-white p-3 rounded border border-gray-200">
                    <span className="text-xs text-gray-500 block">Créé le</span>
                    <span className="font-medium text-gray-800">
                      {new Date(workflowDetails.createdAt).toLocaleString()}
                    </span>
                  </div>
                  <div className="bg-white p-3 rounded border border-gray-200">
                    <span className="text-xs text-gray-500 block">Modifié le</span>
                    <span className="font-medium text-gray-800">
                      {new Date(workflowDetails.updatedAt).toLocaleString()}
                    </span>
                  </div>
                </div>
                
                <div className="mb-4">
                  <h6 className="font-medium mb-2">Nœuds ({workflowDetails.nodes?.length || 0})</h6>
                  <div className="space-y-2">
                    {workflowDetails.nodes?.map((node: any) => (
                      <div key={node.id} className="bg-white p-2 rounded border border-gray-200">
                        <div className="font-medium">{node.name}</div>
                        <div className="text-xs text-gray-500">Type: {node.type}</div>
                      </div>
                    )) || <p className="text-sm text-gray-500">Aucun nœud trouvé</p>}
                  </div>
                </div>
                
                <div className="mb-4">
                  <h6 className="font-medium mb-2">Exécutions récentes</h6>
                  <div className="space-y-2 max-h-[200px] overflow-y-auto">
                    {executionLoading ? (
                      <div className="flex justify-center items-center py-4">
                        <div className="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
                      </div>
                    ) : executions.length > 0 ? (
                      executions.map((execution) => (
                        <div 
                          key={execution.id} 
                          className={`p-2 rounded-md cursor-pointer border ${selectedExecution?.id === execution.id ? 'bg-blue-50 border-blue-300' : 'bg-white border-gray-200 hover:bg-gray-50'}`}
                          onClick={() => setSelectedExecution(execution)}
                        >
                          <div className="flex justify-between items-center">
                            <div>
                              <div className="text-sm font-medium">{new Date(execution.startedAt).toLocaleString()}</div>
                              <div className="text-xs text-gray-500">ID: {execution.id.substring(0, 8)}...</div>
                            </div>
                            <div>
                              <span className={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${execution.status === 'success' ? 'bg-green-100 text-green-800' : execution.status === 'error' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800'}`}>
                                {execution.status}
                              </span>
                            </div>
                          </div>
                        </div>
                      ))
                    ) : (
                      <p className="text-sm text-gray-500 text-center py-2">Aucune exécution récente</p>
                    )}
                  </div>
                </div>
                
                {selectedExecution && executionData && (
                  <div className="mb-4">
                    <h6 className="font-medium mb-2">Résultat de l'exécution</h6>
                    <div className="bg-gray-100 p-3 rounded-md">
                      <pre className="text-xs overflow-x-auto max-h-[200px]">
                        {JSON.stringify(executionData.data, null, 2)}
                      </pre>
                    </div>
                  </div>
                )}
                
                <div>
                  <h6 className="font-medium mb-2">Connexions</h6>
                  <div className="bg-gray-100 p-3 rounded-md">
                    <pre className="text-xs overflow-x-auto">
                      {JSON.stringify(workflowDetails.connections, null, 2)}
                    </pre>
                  </div>
                </div>
                
                <div className="mt-4 flex justify-end space-x-2">
                  <button
                    onClick={() => executeWorkflow(workflowDetails.id)}
                    disabled={executionLoading}
                    className="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    {executionLoading ? (
                      <>
                        <svg className="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                          <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                          <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Exécution en cours...
                      </>
                    ) : (
                      'Exécuter le workflow'
                    )}
                  </button>
                  <a
                    href={`${N8N_URL}/workflow/${workflowDetails.id}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                  >
                    Ouvrir dans n8n
                  </a>
                </div>
              <div className="text-center py-8 bg-gray-50 rounded-lg">
                <p className="text-gray-500">Sélectionnez un workflow pour voir ses détails</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
